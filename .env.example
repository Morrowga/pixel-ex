OPENAI_API_KEY=
LLM_MODEL=gpt-6-luna
# Used automatically if the project has no access to LLM_MODEL yet
LLM_FALLBACK_MODEL=gpt-5.6-luna
PORT=8787
# Dollars per 1 million tokens, used for the cost shown in the terminal
PRICE_INPUT_PER_M=0.2
PRICE_OUTPUT_PER_M=1.2
# Optional: price of cached input, if lower than the normal input price
# PRICE_CACHED_INPUT_PER_M=
# Long random text that seals each lesson's hidden answer. Required on Vercel.
LESSON_SECRET=
# Total tokens all visitors together may use (default on Vercel: 500000; no limit locally).
# For an exact shared count on Vercel, connect an Upstash Redis (Vercel Storage) so KV_REST_API_URL and KV_REST_API_TOKEN are set.
# TOKEN_BUDGET=500000
