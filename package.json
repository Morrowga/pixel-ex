{
  "name": "question-explainer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api \"vite\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "tsx watch --env-file=.env server/index.ts",
    "build": "tsc --noEmit && vite build && node scripts/build-api.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "build:api": "node scripts/build-api.mjs",
    "start": "tsx server/index.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "framer-motion": "^14.6.0",
    "hono": "^4.13.14",
    "mathjs": "^15.2.0",
    "openai": "^7.43.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
